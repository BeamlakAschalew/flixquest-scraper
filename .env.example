# TMDB API Configuration
# Get your API key from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Optional overrides for provider relays that may move or be redeployed.
# BOLLYFLIX_ADDON_URL=https://example.com/stream
# PLAYIMDB_API_URL=https://example.com/api.php

# Optional WatchFlux Cloudflare clearance. Both values must come from the same
# normal browser session and should never be committed with real values.
# WATCHFLUX_CF_CLEARANCE=your_cf_clearance_cookie_value
# WATCHFLUX_USER_AGENT=your_exact_browser_user_agent

# HMAC secret used to sign /proxy stream URLs. Use a long random value.
STREAM_PROXY_SECRET=replace_with_a_long_random_secret

# Server Configuration
PORT=3000
