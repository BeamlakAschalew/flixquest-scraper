# TMDB API Configuration
# Get your API key from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here
INTRO_VIDEO_URL=https://cdn.example.com/flixquest-intro.mp4
INTRO_VIDEO_ENABLED=true

# Optional overrides for provider relays that may move or be redeployed.
# The cookie is only needed if GdFlix starts challenging HTTP/2 requests in
# your deployment region.
# BOLLYFLIX_BASE_URL=https://bollyflix.at
# BOLLYFLIX_GDFLIX_COOKIE=
# PLAYIMDB_API_URL=https://example.com/api.php

# Optional WatchFlux Cloudflare clearance. Both values must come from the same
# normal browser session and should never be committed with real values.
# WATCHFLUX_CF_CLEARANCE=your_cf_clearance_cookie_value
# WATCHFLUX_USER_AGENT=your_exact_browser_user_agent

# Optional forward proxy configuration for bypassing Cloudflare 403 blocks.
# Transient primary failures retry once through the fallback proxy.
FORWARD_PROXY_URL=https://flixquest.beamlak.dev/proxy.php?url=
FORWARD_PROXY_FALLBACK_URL=https://onyx.et/proxy.php?url=
# Set FORWARD_PROXY_ALWAYS=true to force all outbound provider requests through proxy
# FORWARD_PROXY_ALWAYS=false

# Optional TLS connect-proxy pool used as the primary forward proxy tier.
# Loads up to CONNECT_PROXY_POOL_SIZE proxies (default 20) from
# data/forward-proxies.txt (or FORWARD_PROXY_POOL / FORWARD_PROXY_POOL_FILE).
# Requests rotate through the pool with failover: a proxy that fails (network
# error, 403/408/429/5xx) is tried fewer times, and after POOL_MAX_FAILURES
# consecutive failures it is evicted and replaced in-memory with the next
# candidate from data/forward-proxies-backup.txt (or FORWARD_PROXY_BACKUP_POOL).
# The replacement is memory-only (no database): on Vercel cold starts the pool
# rehydrates from the bundled files, so keep the active list current.
# CONNECT_PROXY_TIMEOUT_MS=20000
# CONNECT_PROXY_MAX_ATTEMPTS=3
# CONNECT_PROXY_POOL_SIZE=20
# FORWARD_PROXY_POOL=http://1.2.3.4:443,http://5.6.7.8:443
# FORWARD_PROXY_POOL_FILE=data/forward-proxies.txt
# FORWARD_PROXY_BACKUP_POOL=http://1.2.3.4:443,http://5.6.7.8:443
# FORWARD_PROXY_BACKUP_POOL_FILE=data/forward-proxies-backup.txt

# VidFast player updater (the watch command checks immediately, then hourly)
# VIDFAST_UPDATE_INTERVAL_MS=3600000
# VIDFAST_UPDATE_TIMEOUT_MS=45000
# VIDFAST_UPDATE_PROBE_PATH=/movie/550
# Set only when a structural player change requires inspection without a live stream test.
# VIDFAST_UPDATE_SKIP_LIVE_SMOKE=false

# HMAC secret used to sign /proxy stream URLs. Use a long random value.
STREAM_PROXY_SECRET=replace_with_a_long_random_secret

# Custom Provider Alias Overrides (refer to providers by custom names in your app)
# PROVIDER_ALIAS_VIXSRC=Axum
# PROVIDER_ALIAS_CINEBY=Zeus

# Wyzie Subs API key for fallback subtitles (optional)
# Get a free key at: https://store.wyzie.io/redeem
# WYZIE_SUBS_API_KEY=your_wyzie_api_key_here

# Optional DLHD overrides. Change these if DLHD moves its public site or
# intermediate player host; defaults match the currently deployed site.
# DLHD_BASE_URL=https://dlhd.st
# DLHD_EMBED_BASE_URL=https://hamis.romponalis.st/premiumtv/daddy3.php

# Redis Cache Configuration (optional - app falls back seamlessly if not configured)
# REDIS_URL=redis://default:password@localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_CACHE_TTL=7200 # Cache expiration in seconds (default: 7200 = 2 hours)
# REDIS_CACHE_ENABLED=true # Enable/disable Redis caching layer

# Server Configuration
PORT=3000
